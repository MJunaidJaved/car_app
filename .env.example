# .env.example - Copy this to .env and fill in your actual values
# This file is NEVER committed to version control for security reasons

# Google Places API Key (used for location suggestions)
# Get from: https://console.cloud.google.com/
PLACES_API_KEY=AIza...your_actual_key_here...

# Add other environment variables here as needed
# Example:
# FIREBASE_API_KEY=your_firebase_key
# BACKEND_URL=https://your.backend.url

